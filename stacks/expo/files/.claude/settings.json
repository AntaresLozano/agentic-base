{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:related *)",
      "Bash(pnpm e2e *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx expo-doctor *)",
      "Bash(maestro test *)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun simctl io booted screenshot *)",
      "Bash(xcrun simctl ui booted appearance *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ],
    "deny": ["Bash(git push --force *)", "Bash(git push -f *)", "Read(./.env*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-files.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.mjs",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/statusline.mjs"
  }
}
